<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <!-- hazelcast instance name -->
    <bean id="eidasSpecificCommunicationHazelcastInstance" class="java.lang.String">
        <constructor-arg value="eidasSpecificCommunicationHazelcastInstance"/>
    </bean>

    <!-- hazelcast initializer bean - injected into map providers -->
    <bean id="eidasSpecificCommunicationHazelcastInstanceInitializer" class=" eu.eidas.auth.cache.HazelcastInstanceInitializerSpecificCommunication" init-method="initializeInstance" lazy-init="true">
        <property name="hazelcastConfigfileName" value="#{specificCommunicationConfigRepository}/hazelcast/hazelcastSpecificCommunication.xml"/>
        <property name="hazelcastInstanceName" ref="eidasSpecificCommunicationHazelcastInstance"/>
    </bean>

    <!-- Cache provided by Hazelcast for distributed environment -->
    <bean id="connectorSpecificCacheProvider" class="eu.eidas.auth.cache.HazelcastCacheManager">
        <constructor-arg ref="eidasSpecificCommunicationHazelcastInstanceInitializer"/>
        <constructor-arg>
            <map>
                <entry key="specificNodeConnectorRequestCache" value="${specific.node.connector.request.cache.name}"/>
                <entry key="nodeSpecificConnectorResponseCache" value="${node.specific.connector.response.cache.name}"/>
            </map>
        </constructor-arg>
    </bean>

    <bean id="proxySpecificCacheProvider" class="eu.eidas.auth.cache.HazelcastCacheManager">
        <constructor-arg ref="eidasSpecificCommunicationHazelcastInstanceInitializer"/>
        <constructor-arg>
            <map>
                <entry key="nodeSpecificProxyserviceRequestCache" value="${node.specific.proxyservice.request.cache.name}"/>
                <entry key="specificNodeProxyserviceResponseCache" value="${specific.node.proxyservice.response.cache.name}"/>
            </map>
        </constructor-arg>
    </bean>

    <bean id="specificConnectorCommunicationCacheMetricsBinder" class="eu.eidas.metrics.HazelcastCacheMetricsBinder"
          lazy-init="true">
        <constructor-arg ref="connectorSpecificCacheProvider"/>
        <property name="hazelcastInstanceInitializer" ref="eidasSpecificCommunicationHazelcastInstanceInitializer"/>
        <property name="specificCommunication" value="true"/>
    </bean>

    <bean id="specificProxyCommunicationCacheMetricsBinder" class="eu.eidas.metrics.HazelcastCacheMetricsBinder"
          lazy-init="true">
        <constructor-arg ref="proxySpecificCacheProvider"/>
        <property name="hazelcastInstanceInitializer" ref="eidasSpecificCommunicationHazelcastInstanceInitializer"/>
        <property name="specificCommunication" value="true"/>
    </bean>
</beans>